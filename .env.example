PORT=5000
NODE_ENV=development
Frontend_Url=http://localhost:3000

# MongoDB Connection String (Atlas URI or local instance)
Mongoose_uri=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/nurturely?retryWrites=true&w=majority

# Authentication Secrets
JWT_SECRET=your_jwt_secret_key_here
ACCESS_SECRET=your_access_secret_key_here
REFRESH_SECRET=your_refresh_secret_key_here

# Email Service (Resend or SMTP)
RESEND_API_KEY=re_your_api_key_here
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@example.com
SMTP_PASS=your_app_password
MAIL_FROM=Nurturely CRM <no-reply@nurturely.io>
